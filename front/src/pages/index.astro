---
import Layout from '../layouts/Layout.astro';
---

<Layout title="QR Generator">
	<main class="container">
	<h1>QR Generator</h1>
	
	<div class="card">
		<div class="input-group">
			<label for="qrInput" style="text-align: left; font-size: 0.9rem; color: #94a3b8;">Link or Text</label>
			<input type="text" id="qrInput" placeholder="https://your-site.com" />
		</div>
		
		<button id="generateBtn" style="width: 100%;">Generate QR Code</button>
		
		<div id="result" style="display: none; text-align: center;">
			<img id="qrImage" src="" alt="QR Code" />
			<p>Ready to scan and share</p>
			<button id="downloadBtn" style="background: transparent; border: 1px solid var(--border); margin-top: 10px; font-size: 0.8rem;">Download PNG</button>
		</div>
	</div>
</main>
</Layout>

<script>
	
	const btn = document.getElementById('generateBtn') as HTMLButtonElement | null;
	const input = document.getElementById('qrInput') as HTMLInputElement | null;
	const resultDiv = document.getElementById('result') as HTMLDivElement | null;
	const qrImg = document.getElementById('qrImage') as HTMLImageElement | null;

	if (btn && input && resultDiv && qrImg) {
		const downloadBtn = document.getElementById('downloadBtn');

		downloadBtn?.addEventListener('click', () => {
			if (qrImg?.src) {
				const link = document.createElement('a');
				link.href = qrImg.src;
				link.download = 'my-qr-code.png';
				link.click();
			}
		});

		btn.addEventListener('click', async () => {
			const text = input.value; 
			if (!text) return alert("Please enter some text");

			try {
				btn.innerText = "Generating...";
				btn.disabled = true;

				const apiUrl = import.meta.env.PUBLIC_API_URL;
				const res = await fetch(`${apiUrl}/generate`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ text })
				});
				
				const data = await res.json();

				qrImg.src = data.qr;
				resultDiv.style.display = 'block';

			} catch (error) {
				console.error("Error:", error);
				alert("Failed to connect to the server");
			} finally {
				btn.innerText = "Generate QR";
				btn.disabled = false;
			}
		});
	}
</script>

<style>
	:root {
		--primary: #ff5d01;
		--primary-hover: #e65400;
		--bg: #0f172a;
		--card-bg: #1e293b;
		--text: #f8fafc;
		--border: #334155;
	}

	.container {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background-color: var(--bg);
		color: var(--text);
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		padding: 20px;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 2rem;
		background: linear-gradient(to right, #ff5d01, #ff9e6b);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		font-weight: 800;
	}

	.card {
		background: var(--card-bg);
		padding: 2.5rem;
		border-radius: 24px;
		border: 1px solid var(--border);
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
		width: 100%;
		max-width: 450px;
		transition: transform 0.3s ease;
	}

	.card:hover {
		transform: translateY(-5px);
	}

	.input-group {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 1.5rem;
	}

	input {
		padding: 14px 18px;
		border-radius: 12px;
		border: 2px solid var(--border);
		background: #0f172a;
		color: white;
		font-size: 1rem;
		outline: none;
		transition: border-color 0.2s;
	}

	input:focus {
		border-color: var(--primary);
	}

	button {
		padding: 14px;
		background: var(--primary);
		color: white;
		border: none;
		border-radius: 12px;
		cursor: pointer;
		font-weight: 700;
		font-size: 1rem;
		transition: all 0.2s;
		box-shadow: 0 4px 6px -1px rgba(255, 93, 1, 0.3);
	}

	button:hover:not(:disabled) {
		background: var(--primary-hover);
		transform: scale(1.02);
	}

	button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	#result {
		margin-top: 2rem;
		padding: 20px;
		background: #0f172a;
		border-radius: 16px;
		animation: fadeIn 0.5s ease-out;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: scale(0.9); }
		to { opacity: 1; transform: scale(1); }
	}

	img {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		display: block;
		margin: 0 auto 15px;
		filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.1));
	}

	p {
		color: #94a3b8;
		font-size: 0.9rem;
	}
</style>